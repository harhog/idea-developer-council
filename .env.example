# LLM — online-läge kräver API-nyckel. Utan nyckel körs rådet i offline-heuristik.
#
# Alternativ A: Cline API (rekommenderat, som idea-council — gratismodeller):
#   skapa nyckel på app.cline.bot -> Settings -> API Keys
CLINE_API_KEY=
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_MODEL=openrouter/free
#
# Alternativ B: valfri OpenAI-kompatibel endpoint:
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Alternativt:
OPENAI_API_KEY=
